    <DTS:Executable
      DTS:refId="Package\Get Last Book change"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{D3955315-6AC9-4742-8F82-B8742E6380D7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Get Last Book change"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7D58A1B0-B97E-48EC-871D-5DAF53097F2D}"
          SQLTask:SqlStatementSource="-- 1. Declaramos una variable local en SQL para capturar el valor binario&#xA;DECLARE @UltimaVersion BINARY(8);&#xA;&#xA;-- 2. Creamos una tabla temporal para vaciar lo que escupe tu procedimiento&#xA;DECLARE @TablaTemporal TABLE (Resultado BINARY(8));&#xA;&#xA;INSERT INTO @TablaTemporal&#xA;EXECUTE [dbo].[GetLastPackageRowVersion] @TableName = 'Book';&#xA;&#xA;-- 3. Asignamos el valor a nuestra variable de SQL&#xA;SELECT TOP 1 @UltimaVersion = Resultado FROM @TablaTemporal;&#xA;&#xA;-- 4. Devolvemos el dato con el alias EXACTO que SSIS quiere encontrar&#xA;SELECT ISNULL(@UltimaVersion, 0x0000000000000000) AS StartRowVersion;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="StartRowVersion"
            SQLTask:DtsVariableName="User::StartRowVersion" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Initialize staging tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{265B0150-954C-4B53-8C0D-FC9EA31DFD1A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Initialize staging tables"
