      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7D58A1B0-B97E-48EC-871D-5DAF53097F2D}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE staging.tmp_book_changes;&#xA;TRUNCATE TABLE staging.stg_book;&#xA;TRUNCATE TABLE staging.stg_book_author;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Merge DimBook"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{06778E0D-20B7-4225-AEE9-839A5E29596E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Merge DimBook"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7D58A1B0-B97E-48EC-871D-5DAF53097F2D}"
          SQLTask:SqlStatementSource="EXEC dbo.DW_MergeDimBook;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Sync Book Data"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{2734FB0D-4FB6-4D94-84A9-556227AEEEF0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Sync Book Data"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7D58A1B0-B97E-48EC-871D-5DAF53097F2D}"
          SQLTask:SqlStatementSource="-- 1. Insertar en la tabla de libros de staging usando las columnas que acabamos de crear&#xA;INSERT INTO staging.stg_book (BookID, title, isbn13, language_name, num_pages, publication_date, publisher_name) &#xA;SELECT DISTINCT book_id, title, isbn13, language_name, num_pages, publication_date, publisher_name &#xA;FROM staging.tmp_book_changes; &#xA;&#xA;-- 2. Insertar en la tabla puente de autores&#xA;INSERT INTO staging.stg_book_author (BookID, AuthorID) &#xA;SELECT DISTINCT &#xA;    b.book_id,&#xA;    a.author_id&#xA;FROM staging.tmp_book_changes b&#xA;INNER JOIN Bookstore.dbo.author a &#xA;    ON b.authors = a.author_name;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update LastRowVersion"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{BB6E01EA-2709-4123-8FD1-7D421D3F355D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update LastRowVersion"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7D58A1B0-B97E-48EC-871D-5DAF53097F2D}"
          SQLTask:SqlStatementSource="EXEC dbo.UpdateLastPackageRowVersion 'Book', ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::EndRowVersion"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
