    <DTS:Executable
      DTS:refId="Package\Populate DimDate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Populate DimDate"
      DTS:DTSID="{182E508A-05C3-4CEC-A387-706C626E1D93}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Populate DimDate"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4C871EEC-01F0-401B-AD16-2C8B5057ACB0}"
          SQLTask:SqlStatementSource="SET DATEFIRST 7; -- Establece el Domingo como primer día de la semana&#xA;&#xA;DECLARE @StartDate DATE = '2020-01-01'; -- Fecha de inicio de tu análisis&#xA;DECLARE @EndDate DATE = '2030-12-31';   -- Fecha de fin de tu análisis&#xA;&#xA;-- Evita duplicar datos si ejecutas el paquete más de una vez&#xA;IF NOT EXISTS (SELECT TOP 1 1 FROM dbo.dim_date)&#xA;BEGIN&#xA;    WHILE @StartDate &lt;= @EndDate&#xA;    BEGIN&#xA;        INSERT INTO dbo.dim_date (&#xA;            DateKey, FullDate, DayNumberOfWeek, DayNameOfWeek, &#xA;            DayNumberOfMonth, DayNumberOfYear, WeekNumberOfYear, &#xA;            MonthName, MonthNumberOfYear, CalendarQuarter, &#xA;            CalendarYear, CalendarSemester&#xA;        )&#xA;        VALUES (&#xA;            CONVERT(INT, FORMAT(@StartDate, 'yyyyMMdd')), -- Llave inteligente (Ej: 20260816)&#xA;            @StartDate,&#xA;            DATEPART(WEEKDAY, @StartDate),&#xA;            DATENAME(WEEKDAY, @StartDate),&#xA;            DATEPART(DAY, @StartDate),&#xA;            DATEPART(DAYOFYEAR, @StartDate),&#xA;            DATEPART(WEEK, @StartDate),&#xA;            DATENAME(MONTH, @StartDate),&#xA;            DATEPART(MONTH, @StartDate),&#xA;            DATEPART(QUARTER, @StartDate),&#xA;            DATEPART(YEAR, @StartDate),&#xA;            CASE WHEN DATEPART(MONTH, @StartDate) &lt;= 6 THEN 1 ELSE 2 END&#xA;        );&#xA;&#xA;        SET @StartDate = DATEADD(DAY, 1, @StartDate);&#xA;    END;&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
