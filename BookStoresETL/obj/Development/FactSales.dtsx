                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_I4)(((DT_WSTR,4)[YEAR](#{Package\Load Fact Sales\OLE DB Source.Outputs[OLE DB Source Output].Columns[order_date]})) + [RIGHT]("0" + (DT_WSTR,2)[MONTH](#{Package\Load Fact Sales\OLE DB Source.Outputs[OLE DB Source Output].Columns[order_date]}),2) + [RIGHT]("0" + (DT_WSTR,2)[DAY](#{Package\Load Fact Sales\OLE DB Source.Outputs[OLE DB Source Output].Columns[order_date]}),2))</property>
