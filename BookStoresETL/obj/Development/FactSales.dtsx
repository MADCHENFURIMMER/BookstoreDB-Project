                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    co.order_id,
    ol.line_id,
    co.customer_id,
    ol.book_id,
    co.dest_address_id AS address_id,
    co.order_date,
    ol.price,
    -- Asumimos la cantidad; si no existe el campo, puedes dejar 1 o mapear tu columna real
    1 AS quantity, 
    (ol.price * 1) AS total_amount
FROM dbo.cust_order co
INNER JOIN dbo.order_line ol ON co.order_id = ol.order_id;</property>
